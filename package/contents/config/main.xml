<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="language" type="String"><default>en</default></entry>
    <entry name="shape" type="Int"><default>1</default></entry>
    <entry name="hoverOpen" type="Bool"><default>true</default></entry>
    <entry name="hoverDelay" type="Int"><default>250</default></entry>
    <entry name="autoHeight" type="Bool"><default>true</default></entry>
    <entry name="compactScale" type="Int"><default>100</default><min>50</min><max>200</max></entry>
    <entry name="compactHeight" type="Int"><default>42</default><min>16</min><max>128</max></entry>
    <entry name="compactWidth" type="Int"><default>320</default><min>80</min><max>1000</max></entry>
    <entry name="autoWidth" type="Bool"><default>true</default></entry>
    <entry name="expandedWidth" type="Int"><default>520</default><min>420</min><max>1000</max></entry>
    <entry name="expandedHeight" type="Int"><default>390</default><min>320</min><max>800</max></entry>
    <entry name="expandedScale" type="Int"><default>100</default><min>60</min><max>200</max></entry>
    <entry name="notificationDuration" type="Int"><default>4</default><min>1</min><max>60</max></entry>
    <entry name="notificationPreviews" type="Bool"><default>true</default></entry>
    <entry name="pinnedMode" type="String"><default>auto</default></entry>
    <entry name="monitorSystem" type="Bool"><default>true</default></entry>
    <entry name="monitorPackages" type="Bool"><default>true</default></entry>
    <entry name="monitorLlm" type="Bool"><default>false</default></entry>
    <entry name="showAudioDevice" type="Bool"><default>true</default></entry>
    <entry name="showBattery" type="Bool"><default>true</default></entry>
    <entry name="reduceMotion" type="Bool"><default>false</default></entry>
    <entry name="shelfJson" type="String"><default>[]</default></entry>
  </group>
</kcfg>
